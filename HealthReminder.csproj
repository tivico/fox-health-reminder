<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <StartupObject>HealthReminder.Program</StartupObject>
    <AssemblyName>HealthReminder</AssemblyName>
    <RootNamespace>HealthReminder</RootNamespace>
    <Version>1.0.1</Version>
    <Authors>Dai</Authors>
    <Description>健康提醒小幫手 - 定時提醒喝水與眼睛休息</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Verification\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\app.ico" />
    <None Remove="Resources\water.ico" />
    <None Remove="Resources\eye.ico" />
    <None Remove="Resources\fox-sprites-v3.png" />
    <None Remove="Resources\fox_*.png" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="HealthReminder.Resources.app.ico" />
    <EmbeddedResource Include="Resources\water.ico" LogicalName="HealthReminder.Resources.water.ico" />
    <EmbeddedResource Include="Resources\eye.ico" LogicalName="HealthReminder.Resources.eye.ico" />
    <EmbeddedResource Include="Resources\fox-sprites-v3.png" LogicalName="HealthReminder.Resources.fox-sprites-v3.png" />
    <EmbeddedResource Include="Resources\fox_*.png">
      <LogicalName>HealthReminder.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HealthReminder.Verification" />
  </ItemGroup>

</Project>
